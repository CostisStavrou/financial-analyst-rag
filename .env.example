# Copy to .env and fill in. .env is git-ignored: never commit it.

# SEC asks every client to identify itself: "Full Name email@example.com".
# The downloader refuses to run until this is set.
SEC_USER_AGENT=

# Gemini API key from https://aistudio.google.com/apikey (used for gemini-embedding-001).
GEMINI_API_KEY=

# Embeddings: "gemini" (default) or "local" (offline bge-base, needs `pip install -e ".[local]"`).
# EMBED_MODEL blank = provider default (gemini-embedding-001 / BAAI/bge-base-en-v1.5).
EMBED_PROVIDER=gemini
EMBED_MODEL=
EMBED_DIM=768

# Local Postgres + pgvector from docker-compose.yml (local-only dev credentials).
DATABASE_URL=postgresql://finrag:finrag@localhost:5433/finrag

# Where downloads, parsed chunks and caches go (git-ignored).
DATA_DIR=data
